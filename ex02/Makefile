# **************************************************************************** #
#                                 COMPILER                                     #
# **************************************************************************** #
NAME    = identify

CC      = c++
CFLAGS  = -Wall -Wextra -Werror -std=c++98

# **************************************************************************** #
#                               FILE STRUCTURE                                 #
# **************************************************************************** #

SRC_DIR = src/
OBJ_DIR = obj/
INC_DIR = include/

SRCS 	= 	main.cpp \
			$(SRC_DIR)Base.cpp \
			$(SRC_DIR)A.cpp \
			$(SRC_DIR)B.cpp \
			$(SRC_DIR)C.cpp

OBJS = $(addprefix $(OBJ_DIR)/, $(SRCS:.cpp=.o))

# **************************************************************************** #
#                                   RULES                                      #
# **************************************************************************** #
.SILENT:

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $(NAME)
	
$(OBJ_DIR)/%.o: %.cpp
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I$(INC_DIR) -c $< -o $@

# **************************************************************************** #
#                                 CLEANING                                     #
# **************************************************************************** #
clean:
	rm -rf $(OBJ_DIR)
	rm -rf $(OBJ_DIR)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re