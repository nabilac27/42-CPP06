# **************************************************************************** #
#                                 COMPILER                                     #
# **************************************************************************** #

CC      = c++
CFLAGS  = -Wall -Wextra -Werror -std=c++98

NAME    = identify

# **************************************************************************** #
#                               FILE STRUCTURE                                 #
# **************************************************************************** #

SRC_DIR = src/
INC_DIR = include/
OBJ_DIR = obj/

SRCS = \
	main.cpp \
	$(SRC_DIR)Base.cpp \
	$(SRC_DIR)A.cpp \
	$(SRC_DIR)B.cpp \
	$(SRC_DIR)C.cpp

OBJS = $(addprefix $(OBJ_DIR)/,$(SRCS:.cpp=.o))

# **************************************************************************** #
#                                   RULES                                      #
# **************************************************************************** #

.SILENT:

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) -I$(INC_DIR) $(OBJS) -o $(NAME)

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)
	mkdir -p $(OBJ_DIR)/$(SRC_DIR)

$(OBJ_DIR)/%.o: %.cpp | $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(INC_DIR) -c $< -o $@

# **************************************************************************** #
#                                 CLEANING                                     #
# **************************************************************************** #

clean:
	rm -rf $(OBJ_DIR)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re